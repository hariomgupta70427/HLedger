// This is a template. Copy it to app_constants.dart:
//   cp lib/core/constants/app_constants.dart.example lib/core/constants/app_constants.dart
//
// Secrets are NOT stored in this file. They are injected at build time via
// --dart-define-from-file=dart_defines.json (copy dart_defines.example.json).
// Anything compiled into the APK is extractable, so never hardcode live keys.

class AppConstants {
  static const String appName = 'HLedger';
  static const String tagline =
      'Your Chat. Your Tasks. Your Transactions. Sorted.';
  static const String splashSubtext = 'Smart Ledger for Smarter You';

  // Secrets via --dart-define / --dart-define-from-file. No default values.
  static const String supabaseUrl = String.fromEnvironment('SUPABASE_URL');
  static const String supabaseAnonKey = String.fromEnvironment('SUPABASE_ANON_KEY');
  static const String openRouterKey = String.fromEnvironment('OPENROUTER_KEY');

  /// True when all required secrets were provided at build time.
  static bool get hasRequiredSecrets =>
      supabaseUrl.isNotEmpty && supabaseAnonKey.isNotEmpty;

  // OpenRouter API
  static const String openRouterApiUrl =
      'https://openrouter.ai/api/v1/chat/completions';

  // Model fallback order
  static const List<String> openRouterModels = [
    'google/gemini-2.0-flash-lite-001',
    'google/gemma-3-12b-it:free',
    'google/gemma-3-4b-it:free',
    'mistralai/mistral-small-3.1-24b-instruct:free',
  ];

  // Database Tables
  static const String usersTable = 'users';
  static const String transactionsTable = 'transactions';
  static const String tasksTable = 'tasks';

  // Notification Channel
  static const String notificationChannelId = 'hledger_reminders';
  static const String notificationChannelName = 'Task Reminders';
}
