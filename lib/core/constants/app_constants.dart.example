// This is a template. Copy it to app_constants.dart:
//   cp lib/core/constants/app_constants.dart.example lib/core/constants/app_constants.dart
//
// This app ships NO provider API keys. Both the Groq and Gemini keys live in
// Cloudflare Worker Secrets — see backend/hledger-ai-worker/README.md. The only
// build-time value is the proxy's public address. Never put an API key here:
// anything compiled into the APK is extractable by decompiling it.

class AppConstants {
  static const String appName = 'HLedger';
  static const String tagline =
      'Your Chat. Your Tasks. Your Transactions. Sorted.';
  static const String splashSubtext = 'Smart Ledger for Smarter You';

  // Injected at build time:
  //   flutter build apk --release --dart-define=AI_PROXY_URL=https://...
  //
  // Firebase needs no dart-define: android/app/google-services.json carries the
  // project config and is read by the google-services Gradle plugin at build time.

  /// Address of the HLedger AI proxy. A public URL, NOT a secret.
  static const String aiProxyUrl = String.fromEnvironment('AI_PROXY_URL');

  static bool get hasAiProxy => aiProxyUrl.isNotEmpty;

  // Firestore layout: users/{uid}/transactions and users/{uid}/tasks
  static const String usersCollection = 'users';
  static const String transactionsCollection = 'transactions';
  static const String tasksCollection = 'tasks';

  // Notification Channel
  static const String notificationChannelId = 'hledger_reminders';
  static const String notificationChannelName = 'Task Reminders';
}
